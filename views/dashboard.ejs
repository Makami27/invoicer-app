<%- include('partials/head') %>
<div class="row">
  <h1>Invoices</h1>
  <a class="btn" href="/invoices/new">+ New invoice</a>
</div>
<div class="stats">
  <div class="card">
    <small>Outstanding</small><b><%= money(outstanding) %></b>
  </div>
  <div class="card">
    <small>Overdue</small><b class="bad"><%= money(overdue) %></b>
  </div>
  <div class="card">
    <small>Paid</small><b class="ok"><%= money(paid) %></b>
  </div>
</div>
<div class="scroll">
  <table>
    <tr>
      <th>#</th>
      <th>Client</th>
      <th>Due</th>
      <th>Status</th>
      <th class="r">Total</th>
    </tr>
    <% rows.forEach(r => { %>
    <tr>
      <td><a href="/invoices/<%= r.id %>"><%= num(r.seq) %></a></td>
      <td><%= r.client %></td>
      <td><%= day(r.due_date) %></td>
      <td>
        <span class="tag <%= r.overdue ? 'overdue' : r.status %>"
          ><%= r.overdue ? 'overdue' : r.status %></span
        >
      </td>
      <td class="r"><%= money(r.total) %></td>
    </tr>
    <% }) %> <% if (!rows.length) { %>
    <tr>
      <td colspan="5">No invoices yet.</td>
    </tr>
    <% } %>
  </table>
</div>
<h2>Payment instructions</h2>
<form method="post" action="/settings" class="card">
  <label
    >Shown on every invoice (bank details, PayPal, crypto address, etc.)
    <textarea name="payment_info" rows="3"><%= payment_info %></textarea></label>
    <button>Save</button>
</form>



<!-- 1. Store data in an HTML attribute -->
<div id="server-data" data-payload="<%= outstanding %>"></div>
<div id="server-data2" data-payload="<%= paid %>"></div>
<div id="server-data3" data-payload="<%= overdue %>"></div>

<div class= "card" style="width: 30vw; margin: auto;">
    <canvas id="myChart"></canvas>
</div>

  
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  
  <script>
    let input1= JSON.parse(document.getElementById('server-data').getAttribute('data-payload'));;
    let input2= JSON.parse(document.getElementById('server-data2').getAttribute('data-payload'));;
    let input3= JSON.parse(document.getElementById('server-data3').getAttribute('data-payload'));;


    const ctx = document.getElementById('myChart').getContext('2d');
  
    new Chart(ctx, {
      type: 'doughnut',
      data: {
        labels: ['Outstanding', 'Paid', 'Overdue'],
        datasets: [{
          label: 'Payment Status',
          data: [input1, input2, input3],
          borderWidth: 1
        }]
      },
      
    });
  </script>
   